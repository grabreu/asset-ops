{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "asset-ops-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/web", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "asset-ops-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "apps/api/src/AssetOps.Api", "--launch-profile", "https"],
      "port": 7176,
      "url": "https://localhost:7176"
    }
  ]
}
