{
  "openapi": "3.1.1",
  "info": {
    "title": "AssetOps.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/assets": {
      "get": {
        "tags": ["Assets"],
        "operationId": "ListAssets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetStatus": {
        "enum": ["Available", "InUse", "Maintenance", "Retired"]
      },
      "AssetSummaryDto": {
        "required": [
          "id",
          "tag",
          "name",
          "status",
          "currentHolder",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tag": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AssetStatus"
          },
          "currentHolder": {
            "type": ["null", "string"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Assets"
    }
  ]
}
